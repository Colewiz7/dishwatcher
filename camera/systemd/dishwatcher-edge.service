[Unit]
Description=dishwatcher edge (pi camera monitor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cole
WorkingDirectory=/home/cole/dishwatcher/camera
ExecStart=/home/cole/dishwatcher/camera/venv/bin/python watcher.py
EnvironmentFile=/home/cole/dishwatcher/camera/.env
Restart=always
RestartSec=10

# The 3B+ shares one usb 2.0 bus between the camera and ethernet, so leave it
# headroom. The watcher is mostly idle between motion events anyway.
CPUQuota=60%
OOMPolicy=continue

# The capture module reopens the device itself and only escalates to a usb
# re-authorise after repeated failures, so it needs write access to that one
# sysfs attribute. v1 did the re-authorise in ExecStartPre, which only ran at
# start and so never fixed a wedge that happened later.
ReadWritePaths=/sys/bus/usb/devices

[Install]
WantedBy=multi-user.target
