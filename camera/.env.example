# dishwatcher camera config
# copy to .env and fill in the server address and key

# Where to POST captures. Must be reachable from the Pi, which moves between
# networks, so prefer a stable name over a LAN IP. A raw LAN IP is what broke
# v1: it pointed at colewiz.student.rit.edu, which stopped resolving when RIT
# moved the host to the .device namespace, and nothing noticed.
DISH_SERVER_URL=https://dishes.colewiz.dev/upload
DISH_API_KEY=changeme

# -- camera --
CAMERA_INDEX=0
# MJPG is not optional on a Pi 3B+. The camera offers MJPG at 1280x720@30 but
# YUYV at that size only manages 10fps, because YUYV is uncompressed and does
# not fit the shared USB 2.0 bus. v1 set no FOURCC and silently got YUYV.
CAMERA_FOURCC=MJPG
FRAME_WIDTH=1280
FRAME_HEIGHT=720
CAMERA_FPS=30
# rotate incoming frames: NONE, CW, CCW, 180
CAMERA_FLIP=NONE
JPEG_QUALITY=60

# -- camera watchdog --
# Seconds without a frame before the device is reopened.
CAMERA_STALL_SECONDS=5
CAMERA_REOPEN_BACKOFF=2
# After this many failed reopens, bounce the USB device.
CAMERA_REOPENS_BEFORE_USB_RESET=3
# Find yours with:
#   for d in /sys/bus/usb/devices/*/; do [ "$(cat $d/idVendor 2>/dev/null)" = "26e0" ] && basename $d; done
# NOTE: v1's unit hardcoded 1-1.3, which is not where this camera actually is.
CAMERA_USB_DEVICE=1-1.2

# -- motion trigger --
# Two thresholds, not one. Enter above HIGH, leave below LOW. A single
# threshold is what made v1 log 17390 stops against 735 starts.
MOTION_ENTER_FRACTION=0.020
MOTION_EXIT_FRACTION=0.008
MOTION_ENTER_FRAMES=3
MOTION_EXIT_FRAMES=8
MOTION_MIN_BLOB_AREA=120
MOTION_COOLDOWN_SEC=20
PROCESS_EVERY_N=3
IDLE_SLEEP_MS=50

# -- blame clips --
VIDEO_FPS=5
VIDEO_DURATION=15
CAPTURE_DELAY_SEC=10

# -- reporting --
HEARTBEAT_INTERVAL_SEC=30
HEALTH_INTERVAL_SEC=30
MONITORING_DURATION_SEC=7200
CLEAR_EXIT_COUNT=3
